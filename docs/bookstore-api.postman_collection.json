{
  "info": {
    "name": "Bookstore Management System API",
    "description": "Import in Postman or Thunder Client. Set {{baseUrl}} and {{token}} after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"secret12\"\n}"
        },
        "url": "{{baseUrl}}/api/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"your_password\"\n}"
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "Auth Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "List Books",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/books?page=1&limit=10" }
    },
    {
      "name": "Create Book (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New Book\",\n  \"author\": \"Author\",\n  \"genre\": \"fiction\",\n  \"isbn\": \"978-0000000001\",\n  \"price\": 299,\n  \"stock\": 10\n}"
        },
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "Place Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{ \"book\": \"BOOK_ID_HERE\", \"quantity\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "My Orders",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/orders/my"
      }
    }
  ]
}
