PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookstore?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional: used by npm run create-admin (or pass email/password as CLI args)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_6_chars
ADMIN_NAME=Admin
